  "locks": [
    {
      "app": "Poltel",
      "lockedWhenAny": ["status:suspended", "status:dismissed"],
      "title": "Erişim askıya alındı",
      "message": "Hakkınızda yürütülen idari soruşturma nedeniyle erişim yetkiniz geçici olarak askıya alınmıştır. Daha önce açılmış laboratuvar talepleri Delil Panosu üzerinden işlenmeye devam eder."
    }
  ],
  "timers": [
    {
      "id": "kaymakam-calls",
      "when": "pressure:erdi",
      "whenAny": ["cafe:witness", "notebook-read", "print:adil", "plate:mv", "ev:cctv"],
      "minutes": 4,
      "unlocks": ["kaymakam:calls"]
    },
    {
      "id": "mp-writes",
      "when": "pressure:kaymakam",
      "whenAny": ["plate:mv", "notebook-read"],
      "minutes": 3,
      "unlocks": ["mp:wrote"]
    },
    {
      "id": "bribe-kept",
      "when": "mp:wrote",
      "minutes": 45,
      "unless": "sent:bribe-return",
      "unlocks": ["integrity -= 15", "pressure += 10", "case:internal-investigation"]
    },
    {
      "id": "adil-warns",
      "when": "furkanStatement",
      "minutes": 6,
      "unlocks": ["adil:warns"]
    },
    {
      "id": "card-enhance",
      "when": "kerem:same-man",
      "minutes": 8,
      "unlocks": ["card:enhanced"]
    },
    {
      "id": "meeting",
      "when": "kerem:meeting-set",
      "minutes": 10,
      "unlocks": ["kerem:met"]
    },
    {
      "id": "friday",
      "when": "kerem:contact",
      "minutes": 60,
      "unless": "girl:rescued",
      "unlocks": ["girl:lost"]
    },
    {
      "id": "kerem-relents",
      "when": "kerem:escaped-ambush",
      "minutes": 15,
      "unless": "girl:rescued",
      "unlocks": ["kerem:relents"]
    },
    {
      "id": "warrant",
      "when": "warrant:requested",
      "minutes": 12,
      "unlocks": ["warrant:farm"],
      "alert": {
        "app": "Poltel",
        "title": "Arama kararı",
        "body": "Savcılık çiftlik için arama kararını onayladı."
      }
    },
    {
      "id": "emre-moved",
      "when": "heard:farm",
      "minutes": 30,
      "unless": "emre:rescued",
      "unlocks": ["emre:moved"]
    },
    {
      "id": "emre-moved-press",
      "when": ["heard:farm", "phone:press"],
      "minutes": 8,
      "unless": "emre:rescued",
      "unlocks": ["emre:moved"]
    },
    {
      "id": "kerem-finds-adil",
      "when": ["kerem:hunting", "heard:pension"],
      "minutes": 20,
      "unless": "adil:caught",
      "unlocks": ["adil:dead"]
    },
    {
      "id": "suspension",
      "when": ["case:internal-investigation", "leak:traced"],
      "whenAny": ["integrity < 60", "player:dirty-hands", "pressure >= 70"],
      "minutes": 12,
      "unless": "lawyer:hired",
      "unlocks": ["status:suspended"]
    },
    {
      "id": "reprimand",
      "when": ["case:internal-investigation", "leak:traced"],
      "minutes": 14,
      "unless": "status:suspended",
      "unlocks": ["status:warned"]
    },
    {
      "id": "dismissal",
      "when": ["status:suspended", "ev:farm-tainted"],
      "minutes": 10,
      "unlocks": ["status:dismissed"]
    },
    {
      "id": "warrant-for-detective",
      "when": ["status:dismissed", "kerem:escaped"],
      "minutes": 10,
      "unlocks": ["legal:warrant-issued"]
    },
    {
      "id": "exposure",
      "when": "phone:prosecutor",
      "whenAny": ["adil:caught", "emre:testimony"],
      "minutes": 10,
      "unlocks": ["coverup:exposed"]
    },
    {
      "id": "exposure-press",
      "when": "phone:press",
      "minutes": 5,
      "unlocks": ["coverup:exposed", "danisman:fled"]
    }
  ],
  "hints": [
    {
      "id": "hint-bribe-return",
      "when": "mp:wrote",
      "minutes": 10,
      "unless": "sent:bribe-return",
      "app": "ZaferBank",
      "title": "Hesabınıza 50.000 TL geldi",
      "body": "Beklemediğiniz bir ödeme mi? Para Gönder › Gönderene iade ile tutarı gönderen hesaba geri gönderebilirsiniz."
    },
    {
      "id": "hint-orhun-debt",
      "when": "heard:orhun-debt",
      "minutes": 6,
      "unless": "sent:orhun-debt",
      "app": "ZaferBank",
      "title": "Kayıtlı alıcı: Orhun K.",
      "body": "Orhun K. kayıtlı alıcılarınızda. Para Gönder ile dilediğiniz tutarı gönderebilirsiniz."
    },
    {
      "id": "hint-lawyer",
      "when": "lawyer:offer",
      "minutes": 3,
      "unlessAny": ["sent:lawyer", "lawyer:declined"],
      "app": "ZaferBank",
      "title": "Kayıtlı alıcı: Av. Nesrin Kaya",
      "body": "Avukatlık ücretini Para Gönder › Av. Nesrin Kaya ile ödeyebilirsiniz."
    }
  ],
