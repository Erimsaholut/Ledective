  "locks": [
    {
      "app": "Poltel",
      "lockedWhenAny": ["status:suspended", "status:dismissed"],
      "title": "Erişim askıya alındı",
      "message": "Hakkınızda yürütülen idari soruşturma nedeniyle erişim yetkiniz geçici olarak askıya alınmıştır. Daha önce açılmış laboratuvar talepleri Delil Panosu üzerinden işlenmeye devam eder."
    }
  ],
  "timers": [
    {
      "id": "kaymakam-calls",
      "when": "pressure:erdi",
      "whenAny": ["cafe:witness", "notebook-read", "print:adil", "plate:mv", "ev:cctv"],
      "minutes": 4,
      "unlocks": ["kaymakam:calls"]
    },
    {
      "id": "mp-writes",
      "when": "pressure:kaymakam",
      "whenAny": ["plate:mv", "notebook-read"],
      "minutes": 3,
      "unlocks": ["mp:wrote"]
    },
    {
      "id": "bribe-kept",
      "when": "mp:wrote",
      "minutes": 45,
      "unless": "sent:bribe-return",
      "unlocks": ["integrity -= 15", "pressure += 10", "case:internal-investigation"]
    },
    {
      "id": "adil-warns",
      "when": "furkanStatement",
      "minutes": 6,
      "unlocks": ["adil:warns"]
    },
    {
      "id": "card-enhance",
      "when": "kerem:same-man",
      "minutes": 8,
      "unlocks": ["card:enhanced"]
    },
    {
      "id": "meeting",
      "when": "kerem:meeting-set",
      "minutes": 10,
      "unlocks": ["kerem:met"]
    },
    {
      "id": "friday",
      "when": "kerem:contact",
      "minutes": 60,
      "unless": "girl:rescued",
      "unlocks": ["girl:lost"]
    },
    {
      "id": "kerem-relents",
      "when": "kerem:escaped-ambush",
      "minutes": 15,
      "unless": "girl:rescued",
      "unlocks": ["kerem:relents"]
    },
    {
      "id": "warrant",
      "when": "warrant:requested",
      "minutes": 12,
      "unlocks": ["warrant:farm"],
      "alert": {
        "app": "Poltel",
        "title": "Arama kararı",
        "body": "Savcılık çiftlik için arama kararını onayladı."
      }
    },
    {
      "id": "emre-moved",
      "when": "heard:farm",
      "minutes": 30,
      "unless": "emre:rescued",
      "unlocks": ["emre:moved"]
    },
    {
      "id": "emre-moved-press",
      "when": ["heard:farm", "phone:press"],
      "minutes": 8,
      "unless": "emre:rescued",
      "unlocks": ["emre:moved"]
    },
    {
      "id": "kerem-finds-adil",
      "when": ["kerem:hunting", "heard:pension"],
      "minutes": 20,
      "unless": "adil:caught",
      "unlocks": ["adil:dead"]
    },
    {
      "id": "suspension",
      "when": ["case:internal-investigation", "leak:traced"],
      "whenAny": ["integrity < 60", "player:dirty-hands", "pressure >= 70"],
      "minutes": 12,
      "unless": "lawyer:hired",
      "unlocks": ["status:suspended"]
    },
    {
      "id": "reprimand",
      "when": ["case:internal-investigation", "leak:traced"],
      "minutes": 14,
      "unless": "status:suspended",
      "unlocks": ["status:warned"]
    },
    {
      "id": "dismissal",
      "when": ["status:suspended", "ev:farm-tainted"],
      "minutes": 10,
      "unlocks": ["status:dismissed"]
    },
    {
      "id": "warrant-for-detective",
      "when": ["status:dismissed", "kerem:escaped"],
      "minutes": 10,
      "unlocks": ["legal:warrant-issued"]
    },
    {
      "id": "exposure",
      "when": "phone:prosecutor",
      "whenAny": ["adil:caught", "emre:testimony"],
      "minutes": 10,
      "unlocks": ["coverup:exposed"]
    },
    {
      "id": "exposure-press",
      "when": "phone:press",
      "minutes": 5,
      "unlocks": ["coverup:exposed", "danisman:fled"]
    },
    {
      "id": "hakan-seen",
      "when": "emre:rescued",
      "minutes": 4,
      "unlocks": [
        "hakan:seen"
      ]
    },
    {
      "id": "hakan-arrives",
      "when": "hakan:seen",
      "minutes": 15,
      "unlessAny": [
        "emre:guarded",
        "emre:hidden",
        "emre:bait",
        "hakan:caught"
      ],
      "unlocks": [
        "emre:hurt",
        "witnessDanger += 20"
      ]
    },
    {
      "id": "hakan-guarded",
      "when": "emre:guarded",
      "minutes": 6,
      "unless": "hakan:caught",
      "unlocks": [
        "hakan:caught"
      ]
    },
    {
      "id": "hakan-bait",
      "when": "emre:bait",
      "minutes": 4,
      "unless": "hakan:caught",
      "unlocks": [
        "hakan:caught",
        "ev:hakan-in-act"
      ]
    },
    {
      "id": "hakan-safehouse",
      "when": [
        "emre:hidden",
        "orhun:sold"
      ],
      "minutes": 6,
      "unless": "hakan:caught",
      "unlocks": [
        "emre:hurt",
        "witnessDanger += 20"
      ]
    },
    {
      "id": "hakan-gives-up",
      "when": "emre:hidden",
      "minutes": 20,
      "unless": "hakan:caught",
      "unlocks": [
        "hakan:caught",
        "hakan:surrendered"
      ]
    },
    {
      "id": "hakan-watched",
      "when": "hakan:watched",
      "minutes": 8,
      "unless": "hakan:caught",
      "unlocks": [
        "hakan:caught",
        "heard:hakan-handler"
      ]
    },
    {
      "id": "hakan-after-hurt",
      "when": "emre:hurt",
      "minutes": 6,
      "unless": "hakan:caught",
      "unlocks": [
        "hakan:caught",
        "hakan:surrendered"
      ]
    },
    {
      "id": "orhun-decides",
      "when": "orhun:promised",
      "minutes": 6,
      "unless": "orhun:helped",
      "unlocks": [
        "orhun:sold"
      ]
    },
    {
      "id": "orhun-after-report",
      "when": [
        "orhun:offer",
        "orhun:reported"
      ],
      "minutes": 5,
      "unless": "orhun:refused",
      "unlocks": [
        "orhun:sold"
      ]
    },
    {
      "id": "prosecutor-calls",
      "when": [
        "farm:entered",
        "mp:answered"
      ],
      "whenAny": [
        "hakan:dealt",
        "farm:empty"
      ],
      "minutes": 4,
      "unlocks": [
        "prosecutor:calls"
      ],
      "alert": {
        "app": "MatesApp",
        "title": "Savcı Leyla Koç",
        "body": "Komiser Bey, ifadenizi almam gerekiyor."
      }
    },
    {
      "id": "prosecutor-fallback",
      "when": "farm:entered",
      "minutes": 50,
      "unless": "prosecutor:calls",
      "unlocks": [
        "prosecutor:calls"
      ]
    }
  ],
