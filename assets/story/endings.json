        {"text": "[Taslak] Doğa için hikâye henüz yazılmadı."}
      ]
    },
    {
      "id": "İnanç",
      "title": "İnanç",
      "variants": [
        {"requires": "trust:İnanç >= 70", "text": "[Taslak] İnanç komisere hâlâ güveniyor."},
        {"requires": "trust:İnanç <= 30", "text": "[Taslak] İnanç ekipten ayrılmayı düşünüyor."},
        {"text": "[Taslak] İnanç için hikâye henüz yazılmadı."}
      ]
    },
    {
