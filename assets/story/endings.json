      ]
    },
    {
      "id": "pressure",
      "title": "Ankara",
      "variants": [
        {
          "requires": "pressure >= 70",
          "text": "[Taslak] Üstlerden gelen baskı dosyanın her aşamasında hissedildi."
        },
        {"text": "[Taslak] Ankara bu dosyayı unutmayı tercih etti."}
      ]
    }
  ]
