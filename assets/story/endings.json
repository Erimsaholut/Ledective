{
  "requires": "final:ready",
  "title": "Dosya Kapandı",
  "sections": [
    {
      "id": "case",
      "title": "Berat Yılmaz Dosyası",
      "variants": [
        {
          "title": "Yanlış İnsan",
          "requires": "case:wrong-person",
          "text": "[Taslak] Deliller yanlış yorumlandı; suçlanan kişi gerçek fail değildi."
        },
        {
          "title": "Adaletin Bedeli",
          "requires": ["case:solved", "coverup:exposed"],
          "text": "[Taslak] Cinayet çözüldü, siyasi bağlantılar ortaya çıktı. Bedelini ekip ödedi."
        },
        {
          "title": "Kirli Eller",
          "requires": ["case:solved", "player:dirty-hands"],
          "text": "[Taslak] Masumlar hayatta, ama komiser artık kendisi de soruşturulabilir."
        },
        {
          "title": "Sessiz Zafer",
          "requires": "case:solved",
          "text": "[Taslak] Katil yakalandı, dosya kapandı. Emri verenler dokunulmaz kaldı."
        },
        {"title": "Çözülemeyen Dosya", "text": "[Taslak] Dosya faili meçhul olarak kapandı."}
      ]
    },
    {
      "id": "kerem",
      "title": "Kerem Aydın",
      "variants": [
        {
          "requires": "kerem:arrested",
          "text": "[Taslak] Kerem Aydın tutuklandı. Duruşmada tek kelime etmedi; sadece kız kardeşinin adını söyledi."
        },
        {
          "requires": "kerem:deal",
          "text": "[Taslak] Kerem Aydın savcılıkla iş birliği yaptı. Verdiği ifade vakfın kapısını açtı."
        },
        {
          "requiresAny": ["kerem:escaped", "kerem:escaped-ambush"],
          "text": "[Taslak] Kerem Aydın bir daha görülmedi. Bazıları onu cuma geceleri sanayide gördüklerini söylüyor."
        },
        {"text": "[Taslak] Kerem Aydın hâlâ aranıyor."}
      ]
    },
    {
      "id": "danisman",
      "title": "Halit Yener",
      "variants": [
        {
          "requires": "danisman:fled",
          "text": "[Taslak] Halit Yener kayıtlar yayımlandığı gece ülkeden çıktı. Yakalama kararı hâlâ duruyor."
        },
        {
          "requires": ["coverup:exposed", "!ev:farm-tainted"],
          "text": "[Taslak] Halit Yener tutuklandı. Emre’nin ifadesi ve Berat’ın kayıtları onu mahkûm ettirdi."
        },
        {
          "requires": "ev:farm-tainted",
          "text": "[Taslak] Halit Yener serbest bırakıldı: çiftlikteki deliller hukuka aykırı sayıldı."
        },
        {"text": "[Taslak] Halit Yener hiç yargılanmadı."}
      ]
    },
    {
      "id": "adil",
      "title": "Adil Karaca",
      "variants": [
        {
          "requires": "adil:dead",
          "text": "[Taslak] Adil Karaca sanayide ölü bulundu. Katili hiç aranmadı."
        },
        {
          "requires": "adil:caught",
          "text": "[Taslak] Adil Karaca itirafçı oldu. Cuma gecelerini tek tek anlattı."
        },
        {"text": "[Taslak] Adil Karaca kayıplara karıştı."}
      ]
    },
    {
      "id": "career",
      "title": "Komiser",
      "variants": [
        {"requires": "legal:warrant-issued", "text": "[Taslak] Hakkında yakalama kararı çıkarıldı."},
        {"requires": "status:dismissed", "text": "[Taslak] Meslekten çıkarıldı."},
        {"requires": "status:suspended", "text": "[Taslak] Görevden uzaklaştırıldı."},
        {
          "requires": "integrity < 40",
          "text": "[Taslak] Görevde kaldı ama artık kimse ona eskisi gibi bakmıyor."
        },
        {
          "requires": "doubt >= 3",
          "text": "[Taslak] Dosya kapandığında bile bir şey yerine oturmadı: kimse tatilde olduğunuzu doğrulayamadı."
        },
        {"text": "[Taslak] Görevine devam ediyor."}
      ]
    },
    {
      "id": "witnesses",
      "title": "Tanıklar",
      "variants": [
        {
          "requires": ["girl:rescued", "emre:rescued"],
          "text": "[Taslak] Melis de Emre de kurtarıldı. İkisi aynı duruşmada tanık kürsüsüne çıktı."
        },
        {
          "requires": "emre:moved",
          "text": "[Taslak] Emre bir daha bulunamadı. Çiftliğin bodrumundaki yazı hâlâ duvarda."
        },
        {
          "requires": "girl:rescued",
          "text": "[Taslak] Melis kurtarıldı ve ifade verdi. Emre’den hâlâ haber yok."
        },
        {
          "requires": "girl:found-dead",
          "text": "[Taslak] Melis’e yetişemediniz. Ailesi her cuma deponun önüne çiçek bırakıyor."
        },
        {"requires": "witness:protected", "text": "[Taslak] Kritik tanık korunarak ifade verdi."},
        {"requires": "witnessDanger >= 60", "text": "[Taslak] Tanıklardan biri ortadan kayboldu."},
        {"text": "[Taslak] Tanıklar ifadelerini değiştirmedi."}
      ]
    },
    {
      "id": "Özge",
      "title": "Özge",
      "variants": [
        {"requires": "trust:Özge >= 70", "text": "[Taslak] Özge komisere hâlâ güveniyor."},
        {"requires": "trust:Özge <= 30", "text": "[Taslak] Özge ekipten ayrılmayı düşünüyor."},
        {"text": "[Taslak] Özge için hikâye henüz yazılmadı."}
      ]
    },
    {
